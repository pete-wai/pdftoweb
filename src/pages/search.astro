---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const modules = import.meta.glob('../content/reports/*.json', { eager: true, import: 'default' });
const reports = Object.values(modules) as any[];
---
<Base title="Search the library">
  <main id="main" class="search-main" data-search-base={base}>
    <a class="back-link" href={`${base}/`}>← Library</a>
    <div class="eyebrow search-eyebrow">EVERY WORD, WITHIN REACH</div>
    <h1>Search the library.</h1>
    <p class="search-intro">Find a phrase, a standard, or a detail across the complete text.</p>
    <form id="search-form" role="search">
      <label for="query">Search publications</label>
      <div class="search-input-row"><input type="search" id="query" name="q" placeholder="Try “key establishment”" autocomplete="off" /><button type="submit">Search <span aria-hidden="true">→</span></button></div>
      <div class="search-filter"><label for="report-filter">Search in</label><select name="report" id="report-filter"><option value="">All publications</option>{reports.map((report) => <option value={report.slug}>{report.identifier} — {report.title}</option>)}</select></div>
    </form>
    <p id="search-status" role="status" aria-live="polite">Enter a search above to explore the library.</p>
    <ol id="search-results" class="search-results"></ol>
    <noscript><p>Full-text search needs JavaScript. You can still <a href={`${base}/`}>browse every publication</a> and use your browser’s “Find on page” feature within each report.</p></noscript>
  </main>
  <script>
    const root = document.querySelector<HTMLElement>('[data-search-base]')!;
    const base = root.dataset.searchBase!;
    const form = document.querySelector<HTMLFormElement>('#search-form')!;
    const input = document.querySelector<HTMLInputElement>('#query')!;
    const filter = document.querySelector<HTMLSelectElement>('#report-filter')!;
    const status = document.querySelector<HTMLElement>('#search-status')!;
    const results = document.querySelector<HTMLOListElement>('#search-results')!;
    const params = new URLSearchParams(location.search);
    input.value = params.get('q') || '';
    if ([...filter.options].some((o) => o.value === params.get('report'))) filter.value = params.get('report') || '';
    let request = 0;
    let pagefind: any;
    const renderText = (html: string) => {
      const doc = new DOMParser().parseFromString(html, 'text/html');
      return doc.body.textContent || '';
    };
    const search = async () => {
      const query = input.value.trim();
      const current = ++request;
      const url = new URL(location.href); url.search = '';
      if (query) url.searchParams.set('q', query);
      if (filter.value) url.searchParams.set('report', filter.value);
      history.replaceState(null, '', url);
      results.replaceChildren();
      if (!query) { status.textContent = 'Enter a search above to explore the library.'; return; }
      status.textContent = 'Searching the full text…';
      try {
        pagefind ||= await import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`);
        const response = await pagefind.search(query, filter.value ? { filters: { report: filter.value } } : {});
        const data = await Promise.all(response.results.slice(0, 30).map((result: any) => result.data()));
        if (current !== request) return;
        status.textContent = data.length ? `${response.results.length} ${response.results.length === 1 ? 'publication' : 'publications'} found for “${query}”.` : `No results for “${query}”. Try a shorter phrase or a different term.`;
        data.forEach((item: any) => {
          const li = document.createElement('li');
          const label = document.createElement('p'); label.className = 'eyebrow'; label.textContent = item.meta.report || 'PUBLICATION';
          const h2 = document.createElement('h2'); const link = document.createElement('a'); link.href = item.url; link.textContent = item.meta.title; h2.append(link);
          li.append(label, h2);
          const sections = item.sub_results?.length ? item.sub_results.slice(0, 5) : [item];
          sections.forEach((section: any) => {
            const block = document.createElement('div'); block.className = 'search-section';
            if (section.title && section.title !== item.meta.title) { const a = document.createElement('a'); a.href = section.url || item.url; a.textContent = section.title; block.append(a); }
            const excerpt = document.createElement('p'); excerpt.textContent = renderText(section.excerpt || item.excerpt || ''); block.append(excerpt); li.append(block);
          });
          results.append(li);
        });
      } catch {
        if (current === request) status.textContent = 'Search could not load. Please try again, or open a report and use your browser’s Find on page feature.';
      }
    };
    form.addEventListener('submit', (event) => { event.preventDefault(); search(); });
    filter.addEventListener('change', search);
    if (input.value) search();
  </script>
</Base>
