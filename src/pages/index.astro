---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const modules = import.meta.glob('../content/reports/*.json', { eager: true, import: 'default' });
const reports = Object.values(modules) as any[];
---
<Base title="The reading library">
  <main id="main" class="library-main">
    <section class="library-intro" aria-labelledby="library-title">
      <div class="eyebrow"><span class="status-dot"></span> THE READING LIBRARY</div>
      <h1 id="library-title">Good reports.<br /><span>A better way to read.</span></h1>
      <p>Full publications, thoughtfully adapted for the web.<br class="wide-only" /> Clear typography. Room to breathe. Every detail preserved.</p>
      <a class="text-link" href={`${base}/search/`}>Search the library <span aria-hidden="true">↗</span></a>
    </section>
    <section class="library-list" aria-labelledby="publications-title">
      <div class="section-label"><h2 id="publications-title">Publications</h2><span>{String(reports.length).padStart(2, '0')} {reports.length === 1 ? 'REPORT' : 'REPORTS'}</span></div>
      {reports.map((report, index) => <article class="report-card">
        <div class="report-art" aria-hidden="true"><span class="art-top">READING EDITION</span><span class="art-id">{report.identifier}</span><div class="art-lines"><i></i><i></i><i></i><i></i><i></i></div><span class="art-bottom">PDF → WEB <span>0{index + 1}</span></span></div>
        <div class="report-card-body">
          <div class="eyebrow">{report.identifier} <span class="meta-dot">·</span> {report.date}</div>
          <h3><a href={`${base}/reports/${report.slug}/`}>{report.title}</a></h3>
          <p>{report.description}</p>
          <div class="card-meta">{report.authors.length} authors <span aria-hidden="true">·</span> Continuous reading <span aria-hidden="true">·</span> Original PDF included</div>
          <a class="read-link" href={`${base}/reports/${report.slug}/`}>Read the report <span aria-hidden="true">→</span></a>
        </div>
      </article>)}
    </section>
    <aside class="library-note"><span class="note-symbol" aria-hidden="true">Aa</span><div><h2>Built around the words.</h2><p>Read on any screen, in light or dark. Search the complete text, follow references, and expand tables without losing your place.</p></div></aside>
  </main>
</Base>
